<?xml version="1.0" encoding="utf-8"?>
<!-- LockIn stores a focus session and its history on device only. Nothing is
     backed up or transferred: a restored blocklist/session on a new phone would
     be silently wrong, and focus history is personal. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
